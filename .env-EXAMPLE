POSTGRES_USER=ps_user
POSTGRES_PASSWORD=senha_super_dificil
POSTGRES_DB=criptofile_db
# Porta exposta no host. Troque (ex.: 5433) se já houver um PostgreSQL usando a 5432.
POSTGRES_PORT=5432
# URL usada ao rodar a CLI fora do Docker (uv run criptofile ...).
# Repita aqui os mesmos valores de usuário, senha, porta e banco definidos acima.
DATABASE_URL=postgresql://ps_user:senha_super_dificil@localhost:5432/criptofile_db
