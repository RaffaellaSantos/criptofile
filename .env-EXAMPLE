POSTGRES_USER=ps_user
POSTGRES_PASSWORD=senha_super_dificil
POSTGRES_DB=criptofile_db
# Porta exposta no host. Troque (ex.: 5433) se já houver um PostgreSQL usando a 5432.
POSTGRES_PORT=5432
# Mude @db para localhost para rodar comando fora do docker
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Chave (hex, 32 bytes) do HMAC que assina o log de auditoria. Se omitida,
# o sistema gera uma e a guarda em .audit_key (chmod 600).
# Gerar uma: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=
